# Runtime connection. Local: Docker Postgres from docker-compose.yml (host port 5433).
# Production: Neon *pooled* connection string.
DATABASE_URL=postgres://rovor:rovor@localhost:5433/rovor

# Direct (unpooled) connection used only for migrations. Optional locally; required on Neon.
DATABASE_URL_UNPOOLED=

# Used by the integration test suite only.
DATABASE_URL_TEST=postgres://rovor:rovor@localhost:5433/rovor_test

# Optional. Fine-grained PAT with public-repo read only. Raises GitHub's limit from 60 to 5,000 req/h.
GITHUB_TOKEN=

# debug | info | warn | error
LOG_LEVEL=info
